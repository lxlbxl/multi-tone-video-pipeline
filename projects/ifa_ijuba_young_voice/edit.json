 ],
 "lines": [
  [0.8, 2.5, "Ẹ̀yí Olódùmarè, Ọba àtètégbé"],
  [2.5, 4.5, "Ọ̀gẹ̀gẹ̀ Ọba tó gbé'lẹ̀ ayé gún"],
  [4.5, 6.8, "Aṣíipìrí Ọba tó pa ọjọ́ ikú dà"],
  [6.8, 9.2, "Ọba àwọn ọba, Ọba aláṣọ funfun gbòo"],
  [9.2, 11.2, "Ọba tó ṣ'ayé lọ́gbọ́n-ọ́n-rì"],
  [11.2, 13.0, "Olódùmarè á gbé wa o."],
  [13.0, 14.1, "Àṣẹ."],
  [14.1, 16.3, "Ìbà o ilẹ̀ ọ̀tẹ̀tẹ̀"],
  [16.3, 18.2, "Lààngbòóyè, àtẹ́rẹrẹ k'áyé"],
  [18.2, 20.2, "Àtẹ́lẹsẹ̀ kẹ́ ẹlẹ́ Olódùmarè"],
  [20.2, 22.1, "Ọ̀dẹ̀mùdẹ̀mù kẹ̀tẹ̀, a-lẹ́nu-má-fọhùn"],
  [22.1, 24.2, "Ilẹ̀ ó yún-un yọ́jú wa o."],
  [24.2, 25.0, "Àṣẹ."],
  [25.0, 27.2, "Ìbà orí òkè, ìbà orí odò"],
  [27.2, 29.5, "Ìbà àtíwáyọ́ ọjọ́, ìbà àtúsùnwọ̀ oòrùn"],
  [29.5, 31.5, "Ìbà kùtùkùtù àwọ̀-òwúrọ̀"],
  [31.5, 33.5, "Ìbà gànrìngànrin àwọ̀-ọ̀sán gangan"],
  [33.5, 35.5, "Ìbà wìnrìnwìnrìn àwọ̀-alẹ́"],
  [35.5, 37.8, "Àti òkùtùsùnwì àwọ̀-ọ̀gànjọ́"],
  [37.8, 40.5, "Ìbà afẹ́fẹ́ lẹ́gẹ́lẹ́gẹ́ tí ń ṣ'àwòṣàlú ayé"],
  [40.5, 43.1, "Ìbà ìjì fùfù lẹ́gẹ́lẹ́gẹ́ tí ń ṣ'àwòṣàlú ọ̀run"],
  [43.1, 45.4, "Ìbà ayé, tẹ́tẹ́ mo júbà rẹ o"],
  [45.4, 47.7, "Àkàmọ́ra, ọmọ elẹ́fùnrẹ́, ayé aláàárí"],
  [47.7, 49.5, "Ẹnì kankan kò gbọdọ̀ gbé e lórí"],
  [49.5, 51.5, "Kò gbọdọ̀ jà, kò gbọdọ̀ wó"],
  [51.5, 52.8, "Kò gbọdọ̀ yẹ̀"],
  [52.8, 54.8, "Ayé ò níí bínú sí wa o."],
  [54.8, 55.7, "Àṣẹ."],
  [55.7, 57.8, "Ìbà o Ẹlẹ́yinjú-olú-ẹ"],
  [57.8, 60.5, "Àgbẹ̀gìlérè, ọ̀tọ̀tọ̀ ènìyàn ní 'ṣe Ọlọ́jọ́"],
  [60.5, 62.4, "Gbilẹ̀ ẹ tẹgbẹ́ ní Wìláadò"],
  [62.4, 64.6, "Ẹni tí Olódùmarè kọ́kọ́ pa ọjọ́ ikú rẹ̀ dà"],
  [64.6, 66.8, "Òun ni ọmọ Olúorogbo"],
  [66.8, 68.3, "Ẹlẹ́yinjú-olú á gbé wa o."],
  [68.3, 69.2, "Àṣẹ."],
  [69.2, 71.3, "Ìbà Ọ̀rúnmìlà, Ẹlẹ́rìí-ìpín"],
  [71.3, 73.2, "Ikú dúdú àtẹ́wọ́, ọ̀rọ̀ ajé pọ̀ mọ́kàn"],
  [73.2, 75.8, "Àtórí ẹni tí kò sunwọ̀n ṣe"],
  [75.8, 78.8, "Òdùdú tí ń di orí olé mèrì kí ó má bàa ṣe fọ́"],
  [78.8, 81.3, "À-tó-bá-j'ayé, má j'ayé àlòlò"],
  [81.3, 84.1, "À-sọ̀pẹ́-lẹ́kùù l'Ágbòrò, ọ̀pẹ́ igi ìwàdà"],
  [84.1, 86.4, "Ọmọ ẹnírẹ́, ọmọ ẹnírẹ́"],
  [86.4, 88.8, "Ọmọ kégbè j'ànírẹ́-nírẹ́"],
  [88.8, 90.7, "Ọmọ Sákábí-Àbọ̀"],
  [90.7, 93.3, "Ọmọ ìkọ́lọ́wọ́ owó ò jẹ́ kíku ó rọra"],
  [93.3, 95.0, "Nítorí bí àbẹ̀ ń ṣe"],
  [95.0, 97.4, "Ara Adó-Ẹwí, ara Òkè-Ìgẹ́tí ẹfọn"],
  [97.4, 98.7, "Ara Ìtàgùdù"],
  [98.7, 100.9, "Ara ibi ojúmọ́ rere ti ń mọ́ wá"],
  [100.9, 103.2, "Egungun olóo fẹti sọmọ re o pako"],
  [103.2, 105.4, "Kò gbẹ́ni tì, kò láni tì"],
  [105.4, 107.5, "Ọ̀kìkí tí ń m'ẹ́yìn irin fọn"],
  [107.5, 109.5, "Ọ̀sẹ̀sẹ̀ a-sẹ̀-bí-ẹgà"],
  [109.5, 110.8, "Ọ̀rúnmìlà á gbé wa o."],
  [110.8, 111.7, "Àṣẹ."],
  [111.7, 113.8, "Ìbà o Ògún, Àgbọ́n-n-ìre-Ògún"],
  [113.8, 115.6, "Ọlọ́jọ́ aoribojo"],
  [115.6, 117.0, "Ara òkè tàsè"],
  [117.0, 119.2, "Ara ibi ojúmọ́ rere ti ń mọ́ wá"],
  [119.2, 120.7, "Àgbọ́n-n-ìre-Ògún á gbé wa o."],
  [120.7, 121.7, "Àṣẹ."],
  [121.7, 124.0, "Ìbà o àwọn Ìyá mi Ọ̀ṣọ̀rọ̀ngà"],
  [124.0, 125.7, "Alágogo-ẹyẹ ìṣù"],
  [125.7, 127.3, "A-pa-ni-má-hàgún"],
  [127.3, 128.8, "Olókìkí ohun"],
  [128.8, 131.2, "A-f'ijó-ẹyẹ tí ń fò l'óru nìkan"],
  [131.2, 133.4, "Ẹyẹ ńlá tí ń f'ẹyẹ gbogbo ṣ'ẹ̀rín"],
  [133.4, 135.2, "Òtítí omi"],
  [135.2, 137.4, "Àmẹ́lúwo, àwọn Ìyá mi ò ní f'ojú burúkú sọ wa o."],
  [137.4, 138.8, "Àṣẹ."],
  [138.8, 141.0, "Ìbà o Odù Ológbòòjè"],
  [141.0, 143.8, "Ṣàṣàmújú kìí 'sùn ayé wa"],
  [143.8, 146.5, "Ẹkùn tí ń dákọ lókè l'ójú wákà"],
  [146.5, 147.8, "Odù á gbé wa o."],
  [147.8, 148.9, "Àṣẹ."],
  [148.9, 151.3, "Ìbà o Òrìṣàálá Ọsẹrẹ̀màgbò"],
  [151.3, 153.2, "Ikú Ìkè, ọ̀rọ̀ àdàbà jẹgbìn"],
  [153.2, 155.3, "A-sọmọ ní k'agbára"],
  [155.3, 157.1, "A-wó-bì-ẹrin"],
  [157.1, 159.2, "Ọba tapatapa tí ń b'áwọn gbọ́ 'jọrànnjí"],
  [159.2, 160.8, "Òrìṣà á gbé wa o."],
  [160.8, 161.7, "Àṣẹ."],
  [161.7, 163.6, "Ìbà o Ọ̀ṣun Awúràalù"],
  [163.6, 165.4, "Olóòyà idẹ"],
  [165.4, 166.9, "Arẹwà obìnrin"],
  [166.9, 169.1, "Awẹ́dà k'ótó wẹ̀mọ́"],
  [169.1, 171.1, "Ọ̀ṣun ó wẹ̀mọ́ rẹ fún wa o."],
  [171.1, 172.0, "Àṣẹ."],
  [172.0, 174.5, "Ìbà o Olúkòso Àyìrá"],
  [174.5, 176.4, "Ọmọ Ọ̀bọ̀jà"],
  [176.4, 178.6, "Gba ibi ọ̀tá ṣẹ́gbù"],
  [178.6, 179.45, "Ọmọ afẹ́yìnwọ̀jọ̀ sẹ́tẹ̀…"]
 ]
}
